            selectSimulatorEq(a, b) {
                this.activeA = a;
                this.activeB = b;
                this.tappedIndex = 0; // Reset tap chaser tracker
                
                // Toggle active style on selector buttons
                document.querySelectorAll('.btn-eq').forEach(btn => btn.classList.remove('active'));
                if (a === 4 && b === 2) document.getElementById('eq-btn-1').classList.add('active');
                if (a === 5 && b === 5) document.getElementById('eq-btn-2').classList.add('active');
                if (a === 7 && b === 4) document.getElementById('eq-btn-3').classList.add('active');
                if (a === 8 && b === 5) document.getElementById('eq-btn-4').classList.add('active');

                // Dynamic formula header text update
                const dict = translations[this.lang];
                const sumWord = this.lang === 'zh' ? '等于' : this.lang === 'my' ? 'sama dengan' : 'equals';
                document.getElementById('eq-display-str').textContent = `${a} + ${b} = ${a + b}`;

                this.renderSimulator();
                this.updatePromptUI();
            },

            renderSimulator() {
                const container = document.getElementById('frames-container');
                container.innerHTML = '';

                const total = this.activeA + this.activeB;
                const needTwoFrames = total > 10;
                const framesToCreate = needTwoFrames ? 2 : 1;
                const dict = translations[this.lang];

                let cellIdGlobal = 0;

                for (let f = 1; f <= framesToCreate; f++) {
                    const frameBox = document.createElement('div');
                    frameBox.className = 'frame-box';
                    frameBox.style.borderColor = f === 1 ? 'var(--neon-pink)' : 'var(--neon-blue)';

                    const label = document.createElement('div');
                    label.className = 'frame-label';
                    label.textContent = f === 1 ? dict.frameLabel1 : dict.frameLabel2;
                    frameBox.appendChild(label);

                    const grid = document.createElement('div');
                    grid.className = 'ten-frame-grid';

                    // Create 10 cells for each ten-frame
                    for (let c = 0; c < 10; c++) {
                        const cell = document.createElement('div');
                        cell.className = 'ten-frame-cell';

                        if (cellIdGlobal < this.activeA) {
                            // Populate Pink Group A
                            cell.classList.add('filled-a');
                            cell.innerHTML = `<span class="crystal-item">💎</span><span class="cell-number"></span>`;
                            cell.dataset.activeCrystal = 'true';
                            cell.dataset.globalIndex = cellIdGlobal;
                        } else if (cellIdGlobal < this.activeA + this.activeB) {
                            // Populate Blue Group B
                            cell.classList.add('filled-b');
                            cell.innerHTML = `<span class="crystal-item">🔮</span><span class="cell-number"></span>`;
                            cell.dataset.activeCrystal = 'true';
                            cell.dataset.globalIndex = cellIdGlobal;
                        } else {
                            // Empty cell
                            cell.dataset.activeCrystal = 'false';
                        }

                        // Add Tap event listener for active slots
                        if (cell.dataset.activeCrystal === 'true') {
                            const index = cellIdGlobal;
                            cell.onclick = () => this.handleCellTap(cell, index);
                        }

                        grid.appendChild(cell);
                        cellIdGlobal++;
                    }

                    frameBox.appendChild(grid);
                    container.appendChild(frameBox);
                }

                this.highlightNextCellToTap();
            },

            highlightNextCellToTap() {
                // Clear all chase highlights
                document.querySelectorAll('.ten-frame-cell').forEach(c => c.classList.remove('next-to-tap'));

                // Find globalIndex equal to this.tappedIndex
                const cells = document.querySelectorAll('.ten-frame-cell');
                for (let cell of cells) {
                    if (parseInt(cell.dataset.globalIndex) === this.tappedIndex) {
                        cell.classList.add('next-to-tap');
                        break;
                    }
                }
            },

            handleCellTap(cellElem, index) {
                // To keep slow learners on track, prevent tapping out of order
                if (index !== this.tappedIndex) {
                    // Soft error buzzer
                    AudioEngine.playError();
                    return;
                }

                // Correct sequence tapped!
                AudioEngine.playCountNode(index);
                cellElem.classList.remove('next-to-tap');
                cellElem.classList.add('tapped');
                
                // Inject visual count number over the crystal permanent
                const numSpan = cellElem.querySelector('.cell-number');
                if (numSpan) numSpan.textContent = index + 1;

                this.tappedIndex++;
                this.updatePromptUI();

                if (this.tappedIndex < (this.activeA + this.activeB)) {
                    this.highlightNextCellToTap();
                } else {
                    // All crystals successfully counted
                    AudioEngine.playSuccess();
                }
            },

            updatePromptUI() {
                const dict = translations[this.lang];
                const total = this.activeA + this.activeB;
                const prompt = document.getElementById('prompt-txt');

                if (this.tappedIndex < total) {
                    prompt.textContent = dict.touchPrompt;
                    prompt.style.color = 'var(--neon-blue)';
                } else {
                    prompt.textContent = dict.touchSuccessPrompt;
                    prompt.style.color = 'var(--neon-green)';
                }
            },

            checkLabAns(buttonElem, selectedVal) {
                const correct = 7;
                const dict = translations[this.lang];
                const feedback = document.getElementById('lab-feedback');

                // Clear previous correct/incorrect styles
                document.querySelectorAll('.btn-opt').forEach(btn => {
                    btn.classList.remove('correct', 'incorrect');
                });

                if (selectedVal === correct) {
                    buttonElem.classList.add('correct');
                    feedback.textContent = dict.correctFeed;
                    feedback.style.color = 'var(--neon-green)';
                    AudioEngine.playSuccess();

                    if (!this.quizXpRewarded) {
                        this.quizXpRewarded = true;
                        // Award 10 XP
                        let xp = parseInt(localStorage.getItem('smartkiddo_xp')) || 25;
                        xp = Math.min(xp + 10, 100);
                        localStorage.setItem('smartkiddo_xp', xp);
                        this.userProfile.xp = xp;
                        this.updateGamificationUI();
                    }
                } else {
                    buttonElem.classList.add('incorrect');
                    feedback.textContent = dict.incorrectFeed;
                    feedback.style.color = 'var(--neon-pink)';
                    AudioEngine.playError();
                }
            },

            goBack() {
                window.location.href = 'tambah-tahun1.html';
            }
        };

        window.addEventListener('DOMContentLoaded', () => App.init());
    </script>
</body>
</html>
